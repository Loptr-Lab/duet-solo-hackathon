PORT=8080
# Historical Duet server example, not current Weaver deployment configuration.
# No production Weaver acceptance adapter is configured or selectable.
# These historical OAuth origins do not establish a current authorized service.
PUBLIC_URL=https://duet.loptrlab.com
ATPROTO_BASE_URL=https://duet.loptrlab.com
# Confidential ES256 signing key. Never commit a real value.
ATPROTO_OAUTH_PRIVATE_KEY=
ATPROTO_OAUTH_KEY_ID=duet-key-1
# Weaver owner binding is checked from config/weaver-owner.json.
# Legacy INVITATION_APPROVER_DID does not grant approval or acceptance access.
BLUESKY_HANDLE=the-rift.bsky.social
BLUESKY_APP_PASSWORD=
JSON_BODY_LIMIT=16kb
# Historical Duet game persistence example only; not current PIXIE/Weaver storage.
# Do not restore Google services to enable Weaver acceptance.
# Project number: 381121522073
GOOGLE_CLOUD_PROJECT=adept-crossing-106819
# Optional: secure made-sick.org gateway for verified DUET milestone posts
MADE_SICK_BSKY_WEBHOOK_URL=

